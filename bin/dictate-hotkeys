#!/usr/bin/env bash
# Fallback: bind the default KDE global shortcuts via kglobalshortcutsrc.
# On Plasma 6 / GNOME 48+ the tray binds these itself through the
# GlobalShortcuts desktop portal at startup, and removes any entries this
# script wrote so a press only fires once. Run this only on desktops
# without that portal; elsewhere bind the dictate commands manually.
set -eu
echo "Note: on Plasma 6 / GNOME 48+ the tray binds hotkeys via the desktop"
echo "portal automatically; this script is only for other environments."
command -v kwriteconfig6 >/dev/null || {
    echo "kwriteconfig6 not found (not KDE?). Bind shortcuts manually:"
    echo "  dictate type            Ctrl+Alt+D"
    echo "  dictate-menu            Ctrl+Alt+Space"
    echo "  dictate cancel          Ctrl+Alt+C"
    echo "  dictate listen --toggle Ctrl+Alt+A"
    exit 1
}
kwriteconfig6 --file kglobalshortcutsrc --group services \
    --group dictate.desktop --key _launch "Ctrl+Alt+D"
kwriteconfig6 --file kglobalshortcutsrc --group services \
    --group dictate-menu.desktop --key _launch "Ctrl+Alt+Space"
kwriteconfig6 --file kglobalshortcutsrc --group services \
    --group dictate-cancel.desktop --key _launch "Ctrl+Alt+C"
kwriteconfig6 --file kglobalshortcutsrc --group services \
    --group dictate-listen.desktop --key _launch "Ctrl+Alt+A"
echo "Shortcuts registered; they load at next login, or assign them now in"
echo "System Settings -> Shortcuts (search \"Dictate\")."
