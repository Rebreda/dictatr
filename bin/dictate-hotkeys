#!/usr/bin/env bash
# Fallback: bind the default KDE global shortcuts via kglobalshortcutsrc.
# On Plasma 6 / GNOME 48+ the tray binds these itself through the
# GlobalShortcuts desktop portal at startup, and removes any entries this
# script wrote so a press only fires once. Run this only on desktops
# without that portal; elsewhere bind the dictate commands manually.
set -eu
echo "Note: on Plasma 6 / GNOME 48+ the tray binds hotkeys via the desktop"
echo "portal automatically; this script is only for other environments."
command -v kwriteconfig6 >/dev/null || {
    echo "kwriteconfig6 not found (not KDE?). Bind these by hand:"
    python3 "$(dirname "$(dirname "$(readlink -f "$0")")")/ui/shortcuts.py" |
        while IFS=$'\t' read -r _id keys desc; do
            printf '  %-16s %s\n' "$keys" "$desc"
        done
    exit 1
}
# The set lives in ui/shortcuts.py; this reads it rather than keeping a
# fourth copy. Portal desktops never run this script.
here=$(dirname "$(dirname "$(readlink -f "$0")")")
python3 "$here/ui/shortcuts.py" | while IFS=$'\t' read -r id keys desc; do
    kwriteconfig6 --file kglobalshortcutsrc --group services \
        --group "$([ "$id" = dictate ] && echo dictate || echo "dictate-$id").desktop" \
        --key _launch "$keys"
done

# Plasma <= 6.3 runs a restartable shortcut daemon: reload it so the keys
# work immediately. Newer Plasma hosts shortcuts inside KWin and only
# reads the config at login.
systemctl --user try-restart plasma-kglobalaccel.service 2>/dev/null || true
if systemctl --user is-active -q plasma-kglobalaccel.service 2>/dev/null; then
    echo "Shortcuts registered and active:"
else
    echo "Shortcuts registered. LOG OUT AND BACK IN to activate them, or"
    echo "assign them now in System Settings -> Shortcuts (search Dictate):"
fi
python3 "$here/ui/shortcuts.py" | while IFS=$'\t' read -r _id keys desc; do
    printf '  %-16s %s\n' "$keys" "$desc"
done
