#!/bin/bash
# Drag a region, then ask the AI about it.
#
# The capture has to happen before the chat exists: a region selection is
# a fullscreen grab, and it would otherwise photograph our own window.
#
# The picker is the portal's, which means it is the desktop's own --
# Spectacle on KDE, the shell's on GNOME -- rather than whichever of
# spectacle or grim+slurp happened to be installed.
set -u
. "$(dirname "$(readlink -f "$0")")/_common.sh"
shot=${XDG_RUNTIME_DIR:-/tmp}/dictatr/shot-$$.png
mkdir -p "$(dirname "$shot")"

# A cancelled selection captures nothing; say nothing back.
export DICTATE_SHOT=$shot
dictatr_py -m dictatr.shot >/dev/null || exit 0
[[ -s $shot ]] || exit 0

# Old shots are throwaway context, not an archive.
find "$(dirname "$shot")" -name 'shot-*.png' -mmin +60 -delete 2>/dev/null

export DICTATE_SHOT=$shot
exec "$repo/bin/dictate-chat"
