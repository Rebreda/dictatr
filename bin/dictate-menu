#!/usr/bin/env bash
# The menu. By default a client of the resident shell, so opening it is a
# move inside a surface that is already up rather than a new process.
#
#   dictate-menu                           ask the shell (starting it if need be)
#   dictate-menu --toggle                  ...and put it away if it is already up
#   dictate-menu --settings                the settings scene
#   dictate-menu --suggest                 the suggest scene
#   dictate-menu --standalone [--settings] the same surface, in its own process
#
# --file stays in a process of its own: it is a file dialog with no
# surface at all, which the shell calls until it draws a picker. That is
# also why this passes "$@" on -- it used to drop every argument, so the
# tray's Settings item opened the menu instead of the settings scene.
set -eu
. "$(dirname "$(readlink -f "$0")")/_common.sh"
preload_layer_shell

args=()
standalone=0
scene=menu
for arg in "$@"; do
    case "$arg" in
        --standalone)            standalone=1 ;;
        --file)                  standalone=1; args+=("$arg") ;;
        --settings)              scene=settings; args+=("$arg") ;;
        --suggest)               scene=suggest;  args+=("$arg") ;;
        *)                       args+=("$arg") ;;
    esac
done

if [ "$standalone" -eq 1 ]; then
    exec "$py" "$repo/ui/menu.py" --standalone ${args+"${args[@]}"}
fi
exec "$py" "$repo/ui/shell.py" --client "$scene"
