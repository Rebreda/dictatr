# Demo stage compositor config (template — rendered by lib/session.py).
# A single headless 4K output at 2x: logical 1920x1080, crisp captures.

output HEADLESS-1 mode --custom ${PHYS_W}x${PHYS_H}
output HEADLESS-1 scale ${SCALE}
output HEADLESS-1 bg ${WALLPAPER} fill

seat seat0 xcursor_theme Adwaita 32

default_border none
font pango:Cantarell 11

# Scene windows float at scripted positions; titlebars use the
# client.* palette below.
for_window [app_id="demo-editor"] floating enable, border normal
# Stage props (stage/*.py, app_id demo.*) draw their own titlebars
# via props.titlebar() — no server decoration on top.
for_window [app_id="^demo\."] floating enable, border none
# Sway draws the titlebars for dictatr's plain windows (settings, the
# setup wizard) since GTK4 cedes decoration to it; colors below restyle
# them to the demo palette.
for_window [app_id="^io\.github\.rebreda\.dictatr\."] floating enable, border normal

titlebar_padding 14 8
client.focused          #363943 #23252c #e8eaf1 #8ab4f8 #363943
client.focused_inactive #2b2d34 #1c1d22 #a8abb5 #1c1d22 #2b2d34
client.unfocused        #2b2d34 #1c1d22 #a8abb5 #1c1d22 #2b2d34

bar {
    position top
    font pango:Cantarell 11
    status_command while true; do echo '09:41 '; sleep 3600; done
    workspace_buttons no
    tray_output *
    tray_padding 5
    colors {
        background #1c1d22
        statusline #e8eaf1
    }
}

# Hand the director this session's coordinates.
exec sh -c 'echo "$$WAYLAND_DISPLAY" > ${ENVFILE}; echo "$$SWAYSOCK" >> ${ENVFILE}'
